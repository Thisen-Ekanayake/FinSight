# ── Secrets (NEVER COMMIT) ──────────────────────
.env
*.env
!.env.example
secrets.yaml
secrets.json
*.pem
*.key
service_account.json
api_keys.txt
gemini_key.txt

# ── Data & generated artifacts ──────────────────
# NOTE: `data/*` not `data/` — git cannot un-ignore a file inside an ignored
# directory, so the negation below only works if the dir itself is not ignored.
data/*
!data/.gitkeep
*.db
*.sqlite
*.sqlite3
*.duckdb

# ── Eval outputs (datasets ARE committed) ───────
evals/results/
evals/datasets/alert_cycles/*.recorded.json

# ── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
ENV/

# ── Frontend ────────────────────────────────────
# package-lock.json IS committed — the Docker build runs `npm ci`, which
# refuses to run without it.
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# ── Tooling caches ──────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# ── Model / embedding caches ────────────────────
.fastembed_cache/
.cache/

# ── Editors & OS ────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
.claude/
