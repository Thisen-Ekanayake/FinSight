# ══════════════════════════════════════════════════
# FinSight — Environment
# Copy to .env and fill in. NEVER commit .env.
# Provisioning guide: docs/api_keys.md
# ══════════════════════════════════════════════════

# ── LLM: Google Gemini ────────────────────────────
# Which backend to reach Gemini through:
#   vertex   -> Vertex AI via Application Default Credentials.
#               Run: gcloud auth application-default login
#               Needs aiplatform.googleapis.com enabled. BILLED PER TOKEN.
#   aistudio -> Google AI Studio via GOOGLE_API_KEY (https://aistudio.google.com).
#               Free tier, but metered in requests-per-minute.
GEMINI_BACKEND=vertex

# --- vertex backend ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Only read by docker-compose.yml, and only to decide WHICH credential file to
# mount into the api container — the app itself never reads this. Leave blank
# when running under Docker on your own machine: it defaults to the ADC that
# `gcloud auth application-default login` writes to
# ~/.config/gcloud/application_default_credentials.json.
# Set it to a service-account key path on a server, where there is no browser
# to complete an interactive gcloud login. See docs/deploy.md §2.
GOOGLE_CREDENTIALS_FILE=

# --- aistudio backend ---
GOOGLE_API_KEY=

# Model tiers. Flash is the workhorse; Pro is reserved for the synthesizer
# and the LLM-judge evaluators — it costs several times more per token.
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=4096

# Throttle, applied to every call including parallel fan-out branches.
#   On aistudio this is a QUOTA guard (free tier meters req/min; 429 on excess).
#   On vertex it is a COST guard — quota is high enough that nothing else stops
#   a runaway fan-out from spending real money. Raise deliberately.
GEMINI_RPM_FLASH=30
GEMINI_RPM_PRO=10
GEMINI_MAX_RETRIES=5

# ── Observability: LangSmith ──────────────────────
# Free Developer tier at https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finsight-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Vector store: Qdrant ──────────────────────────
# ⚠️  6335, NOT 6333. Port 6333 belongs to another project on this machine and
# src/vectorstore/client.py will refuse to start if it detects that instance.
QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=
QDRANT_TIMEOUT=30

# ── Embeddings ────────────────────────────────────
# Local ONNX via fastembed — keeps embedding off the rate-limited Gemini quota.
# Changing this model invalidates every tuned dedup threshold: re-run the sweep.
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ── Financial data sources ────────────────────────
# MANDATORY for SEC EDGAR — they return 403 without a descriptive User-Agent.
SEC_USER_AGENT=FinSight/0.1 (your.email@example.com)

# https://fred.stlouisfed.org/docs/api/api_key.html  (free, instant)
FRED_API_KEY=

# https://finnhub.io  (free, 60 calls/min) — primary news source
FINNHUB_API_KEY=

# https://site.financialmodelingprep.com  (free, 250/day) — FALLBACK ONLY, optional
FMP_API_KEY=

# ── Persistence ───────────────────────────────────
DATABASE_URL=sqlite:///data/finsight.db
CHECKPOINT_DB=data/checkpoints.sqlite
HTTP_CACHE_PATH=data/cache/http_cache
EDGAR_CACHE_DIR=data/edgar

# ── Monitoring subsystem (Phase 6+) ───────────────
MONITOR_CADENCE_HOURS=6
# US-listed only — SEC EDGAR has nothing for foreign registrants, and a ticker
# whose CIK is a post-reorganisation successor (as XOM's is) has no 10-K history.
MONITOR_WATCHLIST=AAPL,MSFT,NVDA,JPM,GOOGL
NOTIFICATION_SINKS=console,file

# Phase 7 — Gmail app password, only if you enable the email sink
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_TO=
EMAIL_APP_PASSWORD=

# Phase 7 — run a cycle automatically every MONITOR_CADENCE_HOURS, inside the
# API process. Off by default: enable only after --once --warmup has run, or
# the first scheduled cycle reports every open filing/article/price move at
# once, same as running --once without --warmup first would.
MONITOR_SCHEDULER_ENABLED=false

# ── Dashboard (Phase 8) ─────────────────────────────
# Where src/ui/client.py sends every request. Local default is fine when
# running run_api.sh + run_ui.sh side by side; docker-compose.yml overrides
# this to the in-network hostname (http://api:8000) for the `ui` service.
API_URL=http://localhost:8000

# ── Authentication (Google Sign-In) ───────────────
# OFF by default. The research/monitor CLIs, the eval harness and the test
# suite all run without a browser, so leaving this on would make them
# unrunnable. Turn it on for anything with a public URL — see docs/deploy.md.
#
# When true, BOTH of the settings below must be filled in or the API refuses
# to start: an empty allowlist would lock every account out of a service that
# otherwise looks perfectly healthy.
AUTH_ENABLED=false

# OAuth 2.0 Web client ID from the Google Cloud console. NOT a secret — it
# travels in every OAuth flow and GET /auth/config serves it to the browser.
# Google's model rests on the authorised-origins list and the token signature.
GOOGLE_OAUTH_CLIENT_ID=

# The UNLIMITED TIER. Comma-separated, case-insensitive.
#
# NOT an admission list — any Google account with a verified email may sign in
# and spend FREE_QUERY_LIMIT queries. Naming an address here exempts it from
# that meter, and it is also what the routes that spend unbounded money or
# disclose configuration require: /monitor/* and /admin/*. Leaving it empty
# boots with a warning and means nobody, including you, can reach those.
AUTH_ALLOWED_EMAILS=

# How many research queries a signed-in account outside the unlimited tier may
# run, EVER. Lifetime — there is no reset job and no period column, so an
# account that reaches the limit stays there until its row is edited by hand.
# Exhausting it turns POST /research/query into a 402 carrying CONTACT_URL.
#
# 0 restores the pre-free-tier behaviour: only AUTH_ALLOWED_EMAILS can query.
# The limit is not frozen per account, so raising it later grants the extra
# queries to everyone who already signed up.
FREE_QUERY_LIMIT=5

# Where an exhausted account is sent to ask for more. Served in the 402 body
# and by GET /auth/quota rather than baked into the bundle, so a fork can
# point it at its own contact route without rebuilding the frontend.
CONTACT_URL=https://github.com/Thisen-Ekanayake/FinSight

# Extra browser origins allowed to call the API. Leave EMPTY unless the
# dashboard and API are served from different origins. Empty means same-origin
# only, which is what the shipped nginx setup already is. Never "*": with a
# bearer token in the browser that lets any page you visit drive this API.
CORS_ALLOW_ORIGINS=

# ── Runtime ───────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
