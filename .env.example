# ══════════════════════════════════════════════════
# FinSight — Environment
# Copy to .env and fill in. NEVER commit .env.
# Provisioning guide: docs/api_keys.md
# ══════════════════════════════════════════════════

# ── LLM: Google Gemini ────────────────────────────
# Get one at https://aistudio.google.com (free tier).
GOOGLE_API_KEY=

# Model tiers. Flash is the workhorse; Pro is reserved for the synthesizer
# and the LLM-judge evaluators.
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=4096

# Free-tier limits are requests-per-minute, NOT dollars. Check your current
# quota at https://ai.google.dev/gemini-api/docs/rate-limits and set these to
# ~80% of it. src/core/llm.py throttles every call to stay under.
GEMINI_RPM_FLASH=10
GEMINI_RPM_PRO=4
GEMINI_MAX_RETRIES=5

# ── Observability: LangSmith ──────────────────────
# Free Developer tier at https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finsight-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Vector store: Qdrant ──────────────────────────
# ⚠️  6335, NOT 6333. Port 6333 belongs to another project on this machine and
# src/vectorstore/client.py will refuse to start if it detects that instance.
QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=
QDRANT_TIMEOUT=30

# ── Embeddings ────────────────────────────────────
# Local ONNX via fastembed — keeps embedding off the rate-limited Gemini quota.
# Changing this model invalidates every tuned dedup threshold: re-run the sweep.
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ── Financial data sources ────────────────────────
# MANDATORY for SEC EDGAR — they return 403 without a descriptive User-Agent.
SEC_USER_AGENT=FinSight/0.1 (your.email@example.com)

# https://fred.stlouisfed.org/docs/api/api_key.html  (free, instant)
FRED_API_KEY=

# https://finnhub.io  (free, 60 calls/min) — primary news source
FINNHUB_API_KEY=

# https://site.financialmodelingprep.com  (free, 250/day) — FALLBACK ONLY, optional
FMP_API_KEY=

# ── Persistence ───────────────────────────────────
DATABASE_URL=sqlite:///data/finsight.db
CHECKPOINT_DB=data/checkpoints.sqlite
HTTP_CACHE_PATH=data/cache/http_cache
EDGAR_CACHE_DIR=data/edgar

# ── Monitoring subsystem (Phase 6+) ───────────────
MONITOR_CADENCE_HOURS=6
MONITOR_WATCHLIST=AAPL,MSFT,NVDA,JPM,XOM
NOTIFICATION_SINKS=console,file

# Phase 7 — Gmail app password, only if you enable the email sink
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_TO=
EMAIL_APP_PASSWORD=

# ── Runtime ───────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
